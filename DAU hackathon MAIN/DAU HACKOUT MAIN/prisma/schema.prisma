// Canonical Prisma schema for GridTrade PostgreSQL domain.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PROSUMER
  CONSUMER
  UTILITY
  REGULATOR
  ADMIN
}

enum SolarSystemStatus {
  online
  standby
  offline
}

enum ListingStatus {
  ACTIVE
  PARTIALLY_MATCHED
  FULLY_MATCHED
  CLOSED
  CANCELLED
  EXPIRED
}

enum DemandStatus {
  OPEN
  PARTIALLY_MATCHED
  FULLY_MATCHED
  CLOSED
  CANCELLED
  EXPIRED
}

enum TradeStatus {
  PENDING
  APPROVED
  ADJUSTED
  RESTRICTED
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
  CANCELLED
  REFUNDED
}

enum TransactionStatus {
  pending
  confirmed
  failed
}

enum GridDecision {
  APPROVED
  ADJUSTED
  RESTRICTED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  clerkId      String?       @unique
  email        String        @unique
  displayName  String
  role         UserRole      @default(PROSUMER)
  solarSystems SolarSystem[]
  listings     Listing[]
  demands      Demand[]      @relation("BuyerDemands")
  trades       Trade[]       @relation("BuyerTrades")
  anomalies    Anomaly[]     @relation("UserAnomalies")
  smartRecommendations SmartRecommendation[]
  notifications Notification[]
  acknowledgedAlerts Alert[] @relation("AlertAcknowledger")
  auditLogs    AuditLog[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([email])
  @@index([role])
  @@map("users")
}

model SolarSystem {
  id          String            @id @default(uuid()) @db.Uuid
  ownerId     String            @db.Uuid
  owner       User              @relation(fields: [ownerId], references: [id])
  name        String
  capacityKw  Decimal           @db.Decimal(12, 3)
  location    String
  status      SolarSystemStatus @default(online)
  energyData  EnergyData[]
  listings    Listing[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([ownerId])
  @@map("solar_systems")
}

model EnergyData {
  id                   String      @id @default(uuid()) @db.Uuid
  solarSystemId        String      @db.Uuid
  solarSystem          SolarSystem @relation(fields: [solarSystemId], references: [id])
  observedAt           DateTime
  generationKwh        Decimal     @db.Decimal(14, 4)
  consumptionKwh       Decimal     @db.Decimal(14, 4)
  marketableSurplusKwh Decimal     @db.Decimal(14, 4)
  source               String      @default("prototype")

  @@index([solarSystemId, observedAt])
  @@map("energy_data")
}

model Listing {
  id             String        @id @default(uuid()) @db.Uuid
  sellerId       String        @db.Uuid
  seller         User          @relation(fields: [sellerId], references: [id])
  solarSystemId  String        @db.Uuid
  solarSystem    SolarSystem   @relation(fields: [solarSystemId], references: [id])
  quantityKwh    Decimal       @db.Decimal(14, 4)
  allocatedKwh   Decimal       @default(0) @db.Decimal(14, 4)
  priceInrPerKwh Decimal       @db.Decimal(12, 4)
  availableFrom  DateTime
  availableUntil DateTime
  status         ListingStatus @default(ACTIVE)
  gridDecision   GridDecision  @default(APPROVED)
  trades         Trade[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([status])
  @@index([sellerId])
  @@index([solarSystemId])
  @@index([availableFrom, availableUntil])
  @@map("listings")
}

model Demand {
  id                String       @id @default(uuid()) @db.Uuid
  buyerId           String       @db.Uuid
  buyer             User         @relation("BuyerDemands", fields: [buyerId], references: [id])
  quantityKwh       Decimal      @db.Decimal(14, 4)
  allocatedKwh      Decimal      @default(0) @db.Decimal(14, 4)
  maxPriceInrPerKwh Decimal      @db.Decimal(12, 4)
  availableFrom     DateTime
  availableUntil    DateTime
  status            DemandStatus @default(OPEN)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@index([status])
  @@index([buyerId])
  @@index([availableFrom, availableUntil])
  @@map("demands")
}

model Trade {
  id                   String        @id @default(uuid()) @db.Uuid
  listingId            String        @db.Uuid
  listing              Listing       @relation(fields: [listingId], references: [id])
  buyerId              String        @db.Uuid
  buyer                User          @relation("BuyerTrades", fields: [buyerId], references: [id])
  demandId             String?       @db.Uuid
  quantityKwh          Decimal       @db.Decimal(14, 4)
  agreedPriceInrPerKwh Decimal       @db.Decimal(12, 4)
  gridDecision         GridDecision  @default(APPROVED)
  gridDataId           String?       @db.Uuid
  gridReasonCode       String?
  wheelingFeeInr       Decimal       @default(0) @db.Decimal(14, 4)
  netAmountInr          Decimal       @default(0) @db.Decimal(14, 4)
  status               TradeStatus   @default(CONFIRMED)
  transactions         Transaction[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([listingId])
  @@index([buyerId])
  @@index([demandId])
  @@index([createdAt])
  @@map("trades")
}

model Transaction {
  id         String            @id @default(uuid()) @db.Uuid
  tradeId    String            @unique @db.Uuid
  trade      Trade             @relation(fields: [tradeId], references: [id])
  amountInr  Decimal           @db.Decimal(14, 4)
  status     TransactionStatus @default(confirmed)
  payment    Payment?
  hashRecord HashRecord?
  settledAt  DateTime?
  createdAt  DateTime          @default(now())

  @@index([tradeId])
  @@index([createdAt])
  @@map("transactions")
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  transactionId     String        @unique @db.Uuid
  transaction       Transaction   @relation(fields: [transactionId], references: [id])
  provider          String        @default("prototype_upi")
  providerReference String?
  paymentMethod     String        @default("prototype_upi")
  idempotencyKey    String?       @unique
  amountInr         Decimal       @db.Decimal(14, 4)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?
  metadata          Json?
  createdAt         DateTime      @default(now())

  @@index([status])
  @@map("payments")
}

model HashRecord {
  id               String      @id @default(uuid()) @db.Uuid
  transactionId    String      @unique @db.Uuid
  transaction      Transaction @relation(fields: [transactionId], references: [id])
  blockIndex       Int         @unique
  algorithm        String      @default("SHA-256")
  previousHash     String
  hash             String      @unique
  payloadCanonical String
  createdAt        DateTime    @default(now())

  @@index([blockIndex])
  @@map("hash_records")
}

model PaymentWebhookLog {
  id              String   @id @default(uuid()) @db.Uuid
  provider        String
  providerEventId String
  payloadHash     String
  status          String   @default("processed")
  errorMessage    String?
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@map("payment_webhook_logs")
}

model GridData {
  id                    String         @id @default(uuid()) @db.Uuid
  region                String
  observedAt            DateTime
  congestionPercent     Decimal        @db.Decimal(6, 3)
  renewableSharePercent Decimal        @db.Decimal(6, 3)
  frequencyHz           Decimal        @db.Decimal(8, 4)
  decision              GridDecision
  gridAreaId            String?        @db.Uuid
  gridArea              GridArea?      @relation(fields: [gridAreaId], references: [id])
  predictions           AiPrediction[]

  @@index([region, observedAt])
  @@map("grid_data")
}

model GridArea {
  id              String     @id @default(uuid()) @db.Uuid
  code            String     @unique
  name            String
  substation      String
  capacityKw      Decimal    @db.Decimal(14, 4)
  currentLoadKw   Decimal    @default(0) @db.Decimal(14, 4)
  congestionLevel Decimal    @default(0) @db.Decimal(6, 3)
  gridData        GridData[]
  alerts          Alert[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@map("grid_areas")
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

model Alert {
  id             String        @id @default(uuid()) @db.Uuid
  gridAreaId     String?       @db.Uuid
  gridArea       GridArea?     @relation(fields: [gridAreaId], references: [id])
  type           String
  severity       AlertSeverity @default(WARNING)
  message        String
  acknowledgedBy String?       @db.Uuid
  acknowledger   User?         @relation("AlertAcknowledger", fields: [acknowledgedBy], references: [id])
  acknowledgedAt DateTime?
  metadata       Json?
  createdAt      DateTime      @default(now())

  @@index([severity])
  @@index([createdAt])
  @@map("alerts")
}

enum NotificationType {
  INFO
  ALERT
  TRADE_EXECUTED
  SYSTEM
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  type      NotificationType @default(INFO)
  title     String
  body      String
  read      Boolean          @default(false)
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model AiPrediction {
  id             String    @id @default(uuid()) @db.Uuid
  gridDataId     String?   @db.Uuid
  gridData       GridData? @relation(fields: [gridDataId], references: [id])
  solarSystemId  String?   @db.Uuid
  userId         String?   @db.Uuid
  predictionType String
  horizon        String
  payload        Json
  confidence     Decimal?  @db.Decimal(6, 4)
  modelVersion   String    @default("v1.0")
  staleAt        DateTime?
  createdAt      DateTime  @default(now())

  @@index([predictionType, createdAt])
  @@index([solarSystemId])
  @@index([userId])
  @@map("ai_predictions")
}

enum AnomalyStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model Anomaly {
  id           String        @id @default(uuid()) @db.Uuid
  userId       String?       @db.Uuid
  user         User?         @relation("UserAnomalies", fields: [userId], references: [id])
  entityType   String
  entityId     String?
  score        Decimal       @db.Decimal(6, 4)
  severity     String        // LOW, MEDIUM, HIGH, CRITICAL
  reasons      Json
  modelVersion String        @default("anomaly-rule-v1.0")
  status       AnomalyStatus @default(OPEN)
  reviewedBy   String?       @db.Uuid
  reviewedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("anomalies")
}

model SmartRecommendation {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id])
  kind              String    // SMART_SELL | SMART_BUY
  score             Decimal   @db.Decimal(6, 4)
  listingId         String?   @db.Uuid
  demandId          String?   @db.Uuid
  suggestedQuantity Decimal   @db.Decimal(14, 4)
  suggestedPrice    Decimal   @db.Decimal(12, 4)
  expectedValue     Decimal   @db.Decimal(14, 4)
  reasons           Json
  gridStatus        String
  modelVersion      String    @default("v1.0")
  dismissedAt       DateTime?
  createdAt         DateTime  @default(now())

  @@index([userId, kind])
  @@index([createdAt])
  @@map("smart_recommendations")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  entityType String
  entityId   String?  @db.Uuid
  requestId  String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([entityType])
  @@index([createdAt])
  @@map("audit_logs")
}