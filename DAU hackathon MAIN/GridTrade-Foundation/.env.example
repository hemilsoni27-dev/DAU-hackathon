# Runtime environment
NODE_ENV=development
PORT=5000
BASE_PATH=/api

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/gridtrade

# Cache / Realtime
REDIS_URL=redis://localhost:6379

# CORS — comma-separated list of allowed origins
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info

# AI Service
AI_SERVICE_URL=http://localhost:8000

# Auth (OIDC / JWT extension boundary)
# Required in production — leave blank for local demo mode
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=604800

# Clerk OIDC (optional — future OIDC integration)
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Demo / Development mode
# Set to true to enable demo reset endpoint and demo bearer tokens
# Must be false or unset in production
DEMO_MODE=false

# Frontend demo flag (Vite)
# Set to true to show Demo Control Panel in the web UI
VITE_DEMO_MODE=false